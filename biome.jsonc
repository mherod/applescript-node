{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite"],
  "formatter": {
    "enabled": false
  },
  "linter": {
    "rules": {
      "nursery": {},
      "style": {
        "noMagicNumbers": "off",
        "useBlockStatements": "off",
        "useAtIndex": "off",
        "noNestedTernary": "off",
        "useTemplate": "off",
        "useReadonlyClassProperties": "off",
        "useConsistentMemberAccessibility": "off"
      },
      "correctness": {
        "noUnusedPrivateClassMembers": "off",
        "noUnusedFunctionParameters": "off"
      },
      "complexity": {
        "noStaticOnlyClass": "off",
        "noExcessiveCognitiveComplexity": "off"
      },
      "performance": {
        "useTopLevelRegex": "off",
        "noBarrelFile": "off"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noThenProperty": "off",
        "noEvolvingTypes": "off",
        "noAssignInExpressions": "off",
        "useAwait": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["examples/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "useIterableCallbackReturn": "off",
            "noEvolvingTypes": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "noForEach": "off"
          },
          "style": {
            "noMagicNumbers": "off",
            "useTemplate": "off",
            "useBlockStatements": "off"
          },
          "correctness": {
            "useParseIntRadix": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          }
        }
      }
    }
  ]
}
